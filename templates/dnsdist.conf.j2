-- disable security status polling via DNS
setSecurityPollSuffix("")

controlSocket('127.0.0.1:5199')
setConsoleACL({"127.0.0.1"})
setKey("{{ dnsdist_console_key | default(lookup( 'community.general.random_string', length=32, base64=True)) }}")

local blocklist = newLMDBKVSTore('{{ dnsdist_etc_dir }}/{{ dnsdist_lmdb_name }}', '')

{% for local in dnsdist_local_addresses %}
addLocal("{{ local.name }}:{{ local.port }}")
{% endfor %}

newServer({address="8.8.8.8:53", order=1})
newServer({address="8.8.4.4:53", order=1})
newServer({address="1.1.1.2:53", order=1})

pc = newPacketCache(10000, {
        maxTTL = 86400,
        minTTL = 0,
        temporaryFailureTTL = 60,
        staleTTL = 60,
        keepStaleData = true,
})
setStaleCacheEntriesTTL(3600)

getPool(""):setCache(pc)

-- Block domains on blocklist
addAction(AllRule(), LuaAction(function(dq)
  if isBlocked(dq.qname:toString()) then
    if dq.qtype == DNSQType.AAAA then
      return DNSAction.Spoof, "100::1"
    else
      return DNSAction.Spoof, "0.0.0.0"
    end
  end
  return DNSAction.None, ""
end))

addAction(AllRule(), PoolAction(""))

