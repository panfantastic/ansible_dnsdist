-- disable security status polling via DNS
setSecurityPollSuffix("")

controlSocket('127.0.0.1:5199')
setConsoleACL({"127.0.0.1"})
setKey("{{ dnsdist_console_key | default(lookup( 'community.general.random_string', length=32, base64=True)) }}")

local blocklist = newLMDBKVSTore('{{ dnsdist_etc_dir }}/{{ dnsdist_lmdb_name }}', '')

{% for local in dnsdist_local_addresses %}
addLocal("{{ local.name }}:{{ local.port }}")
{% endfor %}

newServer({address="8.8.8.8:53", order=1})
newServer({address="8.8.4.4:53", order=1})
newServer({address="1.1.1.2:53", order=1})

pc = newPacketCache(10000, {
        maxTTL = 86400,
        minTTL = 0,
        temporaryFailureTTL = 60,
        staleTTL = 60,
        keepStaleData = true,
})
setStaleCacheEntriesTTL(3600)

getPool(""):setCache(pc)

-- logging begin --
fsutcp = newFrameStreamTcpLogger("127.0.0.1:6000")
local function markSpoofed(dr, tap)
  if dr:getTag('spoofed') ~= "" then
    tap:setExtra('SPOOFED')
  end
end

addAction(AllRule(), DnstapLogAction("dnsdist", fsutcp))
addResponseAction(AllRule(), DnstapLogResponseAction("dnsdist", fsutcp))
addSelfAnsweredResponseAction(AllRule(), DnstapLogResponseAction("dnsdist", fsutcp, markSpoofed))
-- logging end --

-- blocklist begin --
addAction(AllRule(), KeyValueStoreLookupAction(blocklist, KeyValueLookupKeySuffix(), 'blocklist-hit'))
addAction(TagRule('blocklist-hit', ''), NoneAction())
addAction(
  AndRule({ TagRule('blocklist-hit', '1'), QTypeRule(DNSQType.AAAA) }),
  LuaAction(function(dq) dq:setTag('spoofed', '1'); return DNSAction.Spoof, "100::1" end)
)
addAction(
  AndRule({ TagRule('blocklist-hit', '1'), NotRule(QTypeRule(DNSQType.AAAA)) }),
  LuaAction(function(dq) dq:setTag('spoofed', '1'); return DNSAction.Spoof, "0.0.0.0" end)
)
-- blocklist end --


-- default pool
addAction(AllRule(), PoolAction(""))

