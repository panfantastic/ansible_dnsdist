#!/bin/bash

{% for i in blocklist_urls %}
  {% for j in i.files %}
wget -4 -O "{{ dnsdist_etc_dir }}/lists/{{ j }}" "{{ i.domain }}/{{ j }}"
  {% endfor %}
{% endfor %}

grep -E -vxf {{ dnsdist_etc_dir }}/allowlist.txt <(cat {{ dnsdist_etc_dir }}/lists/*.txt |sort -n |uniq) > "{{ dnsdist_etc_dir }}/blocklist.txt"

chmod 644 "{{ dnsdist_etc_dir }}/blocklist.txt"

